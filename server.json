{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nandodani/naymme",
  "title": "naymme",
  "description": "Check a candidate name's availability across 61+ providers — domains, code registries, hosted platforms, app stores and socials — and score it for brand quality. No API keys required.",
  "version": "0.1.0",
  "websiteUrl": "https://naymme.vercel.app",
  "repository": {
    "url": "https://github.com/nandodani/naymme",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "naymme",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://naymme.vercel.app/api/mcp"
    }
  ]
}
