# naymme runs without any API keys — copy to .env.local and adjust if needed.

# Port the standalone Node HTTP server listens on (npm run start:http / dev:http)
PORT=3000

# Bind address for the standalone Node HTTP server
HOST=0.0.0.0

# "live" (default) queries real registries; "demo" answers every check with
# deterministic fixture data — no network. Used by CI and the e2e suite.
# NAYMME_AVAILABILITY_MODE=live
